":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/OcrFrameGroup"}}}}}}}},"/api/v1/videos/{videoId}/ocr/frames":{"get":{"tags":["video-multimodal"],"summary":"Get OCR results for a video, grouped by frame (paged)","description":"Returns a paged list of OcrFrameGroup records ordered by frame timestamp ascending.","operationId":"ocrResultsByFramePage","parameters":[{"name":"videoId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"page","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":0}},{"name":"size","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":25}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PageResponseOcrFrameGroup"}}}}}}},"/api/v1/videos/{videoId}/multimodal-timeline":{"get":{"tags":["video-multimodal"],"summary":"Get the fused multimodal timeline for a video","description":"Returns vidingest_multimodal_segments rows in segment_index order. Optional fromSeconds/toSeconds window the result to a temporal slice.","operationId":"multimodalTimeline","parameters":[{"name":"videoId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"fromSeconds","in":"query","required":false,"schema":{"type":"number","format":"double"}},{"name":"toSeconds","in":"query","required":false,"schema":{"type":"number","format":"double"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/MultimodalSegmentDto"}}}}}}}},"/api/v1/videos/{videoId}/multimodal-timeline/page":{"get":{"tags":["video-multimodal"],"summary":"Get the fused multimodal timeline for a video (paged)","description":"Returns a paged view of vidingest_multimodal_segments in segment_index order. Optional fromSeconds/