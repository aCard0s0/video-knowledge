# Copy to `.env` and fill in. `.env` is gitignored (`**/.env`); this file is not — never
# paste a key into this one.
#
#   cp .env.example .env
#
# THIS FILE IS FOR COMPOSE INTERPOLATION. Compose reads `.env` from the project directory to
# fill in ${...}; it does not hand the file to any container. Do not add it to a service's
# `env_file:` — that would dump every line below, TS_AUTHKEY included, into that container.
# Host ports live in compose/ports.env instead, which is tracked because none of it is secret.

# ── Phases ───────────────────────────────────────────────────────────────────────────
# FRAME_SAMPLE is pure ffmpeg in-process, so it needs no sidecar and is safe to leave on.
VIDINGEST_FRAMES_ENABLED=true

# OCR and DIARIZE call sidecars: `./vk build sidecars` then `./vk start sidecars`, and wait
# for both to report healthy. Enabling a phase whose sidecar is unreachable fails the phase,
# and with it the whole run. OCR also needs FRAME_SAMPLE above — it consumes the frames.
VIDINGEST_OCR_ENABLED=false
VIDINGEST_DIARIZATION_ENABLED=false

# KNOWLEDGE is the most expensive phase in the pipeline, so it is opt-in.
VIDINGEST_KNOWLEDGE_ENABLED=false

# ── diarize-asr ──────────────────────────────────────────────────────────────────────
# pyannote/speaker-diarization-3.1 is gated: accept its EULA on huggingface.co and paste a
# read token. Empty means the sidecar starts and /health passes, but the first real call 500s.
HUGGINGFACE_TOKEN=

# ── Remote model providers (optional) ────────────────────────────────────────────────
# All three default to the host runtime (VK_HOST_LLM_URL in compose/ports.env). Set a key
# here and switch the provider to `openai` from the console's Settings screen — or with
# `PUT /api/v1/connections/{name}`, which needs no restart.
VIDINGEST_KNOWLEDGE_API_KEY=
VIDINGEST_EMBEDDINGS_API_KEY=
VIDINGEST_TRANSCRIPTION_API_KEY=

# ── Tailnet access (optional) ────────────────────────────────────────────────────────
# Only read when the stack is started with `./vk start --serve <mode>`. Read
# compose/tailscale/ACL.md first: the ACL must be in place before the first start, and this
# application has no authentication, so the ACL is the entire access control.

# The MagicDNS name, and therefore the URL: https://<TS_HOSTNAME>.<your-tailnet>.ts.net
# Must not equal any compose service name — `video-knowledge` is safe, `webapp` is not.
TS_HOSTNAME=video-knowledge

# REQUIRED for --serve. Pin it; `latest` and `stable` both move, and the sidecar contract has
# changed across releases. https://hub.docker.com/r/tailscale/tailscale/tags
TS_IMAGE_TAG=v1.102.3

# REQUIRED for --serve. Mint at https://login.tailscale.com/admin/settings/keys as REUSABLE
# and TAGGED (tag:server). Never ephemeral — ephemeral nodes are deleted on disconnect, which
# fights the tailscale_state volume and burns a new node every restart. Spent once: identity
# lives in the volume, so rotating this needs no redeploy.
TS_AUTHKEY=

# Extra flags for `tailscale up`. The common one, when the key itself is untagged:
#   TS_EXTRA_ARGS=--advertise-tags=tag:server
TS_EXTRA_ARGS=

# Sidecar limits. GOMEMLIMIT is what actually bounds tailscaled's userspace netstack; the
# mem_limit is only a kernel backstop. Do not lower one without the other.
TS_GOMEMLIMIT=128MiB
TS_GOMAXPROCS=2
TS_MEM_LIMIT=256m

# ── Layering defaults (optional) ─────────────────────────────────────────────────────
# Standing preferences for what `./vk start` brings up, so the flags do not have to be
# typed every time. A flag on the command line always wins over these.
#
# LOCAL_PORT_ENABLED  publish the console on VK_BIND_ADDR:WEBAPP_PORT.
#                     Unset: on, unless --serve puts the stack on a tailnet — then off,
#                     because a published port is a second door the ACL does not guard.
#                     Set it true to keep both; loopback makes that a door for someone
#                     already on the host rather than an exposure. `--no-local` overrides.
# VK_TAILSCALE_ENABLED  bring the sidecar up without passing --serve. TS_SERVE_MODE then
#                     picks the posture (https, or funnel — see compose/tailscale/ACL.md,
#                     and do not).
# LOCAL_PORT_ENABLED=true
# VK_TAILSCALE_ENABLED=true
# TS_SERVE_MODE=https
