cmd_doctor() {
  no_args "$@"
  local missing=0 broken=0
  say "root      $ROOT"
  if have docker; then say "docker    $(docker --version 2>/dev/null)"
  else warn "docker    MISSING — install Docker Desktop"; missing=1; fi
  if docker compose version >/dev/null 2>&1; then say "compose   $(docker compose version --short 2>/dev/null)"
  else warn "compose   MISSING — this needs the Compose v2 plugin, not docker-compose"; missing=1; fi
  if docker info >/dev/null 2>&1; then say "daemon    running"
  else warn "daemon    NOT RUNNING — start Docker Desktop"; broken=1; fi
  if [ -x "$ROOT/mvnw" ]; then say "mvnw      present"
  else warn "mvnw      MISSING — wrong repo, or the wrapper was deleted"; missing=1; fi
  if have java; then
    local jv; jv=$(java -version 2>&1 | head -1)
    say "java      $jv"
    case "$jv" in *\"2[6-9]* | *\"[3-9][0-9]*) ;; *) warn "java      the build enforces Java 26 — this looks older"; broken=1 ;; esac
  else warn "java      MISSING — the build enforces Java 26"; missing=1; fi
  if have npm; then say "npm       $(npm --version 2>/dev/null)"
  else warn "npm       MISSING — install Node 22+"; missing=1; fi
  if [ -d "$WEBAPP_DIR/node_modules" ]; then say "console   dependencies installed"
  else warn "console   dependencies MISSING — run ./$PROG setup"; broken=1; fi
  if [ -f "$ENV_FILE" ]; then say "env       $ENV_FILE"
  else say "env       none (compose defaults apply — this is fine)"; fi
  # The model runtimes are on the host, not in compose, so nothing else here would notice
  # them being down until a phase fails minutes into a run.
  #
  # VK_HOST_LLM_URL is the CONTAINER-facing address, and host.docker.internal does not
  # resolve out here — probing it verbatim reports a healthy runtime as down. Translate to
  # loopback for this one check. The reverse trap is real too and is not ours to fix from
  # here: the server must bind 0.0.0.0, because a loopback-only listener answers this probe
  # and still refuses the container arriving on the bridge address.
  local llm="${VK_HOST_LLM_URL:-http://localhost:8000/v1}"
  local probe="${llm/host.docker.internal/localhost}"
  if ! have curl; then warn "host llm  cannot probe — curl is not on PATH"; broken=1
  elif curl -fsS --max-time 2 "$probe/models" >/dev/null 2>&1; then say "host llm  answering at $probe"
  else warn "host llm  NOT ANSWERING at $probe — start the oMLX server bound to 0.0.0.0, or"
       warn "          repoint the connections (PUT /api/v1/connections/{name})"; broken=1; fi
  if [ -n "$TAILSCALE_ON" ]; then
    if [ -n "${TS_IMAGE_TAG:-}" ]; then say "ts image  tailscale/tailscale:$TS_IMAGE_TAG"
    else warn "ts image  UNPINNED — add TS_IMAGE_TAG to $ENV_FILE (see .env.example)"; broken=1; fi
    # Presence only, never the value.
    if [ -n "${TS_AUTHKEY:-}" ]; then say "ts key    present (spent once; identity is in the volume)"
    else warn "ts key    MISSING from $ENV_FILE — see compose/tailscale/ACL.md"; broken=1; fi
    local mode="${TS_SERVE_MODE:-https}"
    if [ -f "$ROOT/compose/tailscale/serve-$mode.json" ]; then say "ts serve  serve-$mode.json"
    else warn "ts serve  no compose/tailscale/serve-$mode.json"; broken=1; fi
    [ "$mode" != "funnel" ] || warn "ts serve  FUNNEL is on — the console is public, and nothing here authenticates"
    local ts; ts=$(tailnet_state)
    if [ -z "$ts" ]; then say "tailnet   sidecar not running (start it with --serve $mode)"
    elif [ "${ts%% *}" = "Running" ]; then say "tailnet   ${ts##* } (Running)"
    else warn "tailnet   node is '${ts%% *}' — check TS_AUTHKEY and the ACL port for '$mode'"; broken=1; fi
    # A published port beside Serve is a second door the ACL does not guard.
    if [ -n "$LOCAL_PORT_ON" ]; then
      warn "exposure  --local is on beside --serve: the console also answers on ${VK_BIND_ADDR}:${WEBAPP_PORT:-8052}"
    fi
    # The one combination that turns a loopback convenience into an ungoverned tailnet
    # surface. If this host is itself a tailscale node, 0.0.0.0 includes its tailscale0
    # interface, so peers reach vidingest:8051 at the host's tailnet IP — bypassing Serve
    # and the ACL written for the sidecar's tag. It looks tailnet-only and is governed by
    # nothing. On Linux it also survives ufw/firewalld, since Docker's DNAT sits in
    # PREROUTING ahead of INPUT.
    if [ "$VK_BIND_ADDR" != "127.0.0.1" ] && [ "$VK_BIND_ADDR" != "::1" ]; then
      warn "exposure  VK_BIND_ADDR is $VK_BIND_ADDR, not loopback. Every other service's port"
      warn "          is then on every interface this host has — including tailscale0 if the"
      warn "          host is a node, which bypasses Serve and the ACL entirely."
      broken=1
    else
      say "exposure  the remaining ports (api, db, mcp, sidecars) are loopback-only"
    fi
  fi
  # The registry is the source of truth only if nothing drifts from it. This is the lint
  # from the skill, run here rather than only in CI.
  local drift; drift=$(doctor_drift)
  if [ -z "$drift" ]; then say "registry  every command has a row and a function"
  else warn "registry  DRIFT — $drift"; broken=1; fi
  [ "$missing" -eq 0 ] || die "a required dependency is missing (see above)" 3
  [ "$broken" -eq 0 ] || die "a dependency is present but not usable (see above)" 4
  say "healthy"
}
doctor_drift() {
  local fns rows
  fns=$(grep '^cmd_' "$SELF" | sed 's/^cmd_//;s/() .*//' | grep -v '_help$' | sed 's/_/ /g' | sort)
  rows=$(reg_names | sort)
  [ "$fns" = "$rows" ] || printf 'registry rows and cmd_ functions differ'
}
cmd_doctor_help() { say "  Read-only. Exits 3 for a missing tool, 4 for one present but unusable —"
                    say "  the deliberate inverse of status, which exits 0 whenever it could observe."; }
cmd_version() {
  no_args "$@"
  local v
  v=$(git -C "$ROOT" describe --tags --always --dirty 2>/dev/null || true)
  [ -n "$v" ] || die "cannot determine the revision — not a git checkout?" 1
  say "$PROG $v"
  say "project-cli vocabulary rev 1 — clean means build artifacts, status exits 0 when down"
}
# ── dispatcher: resolution only, no command logic ──
main() {
  # Layering first: `logs`, `down` and `status` need the same -f set as the `up` that made
  # the stack, so this cannot wait until a command function runs.
  extract_layering_flags "$@"
  set -- ${LAYERING_ARGS[@]+"${LAYERING_ARGS[@]}"}
  resolve_layering
  while [ $# -gt 0 ]; do
    case "$1" in
      -n|--dry-run) DRY_RUN=1 ;;    -y|--yes)     ASSUME_YES=1 ;;
      -v|--verbose) VERBOSE=1 ;;    -V|--version) cmd_version; return 0 ;;
      -h|--help)    usage; return 0 ;;
      --) shift; break ;;
      -*) warn "unknown global option: $1"; usage >&2; exit 2 ;;
      *)  break ;;
    esac
    shift
  done
  if [ $# -eq 0 ]; then usage; return 0; fi    # bare invocation: help on stdout, exit 0
  local name fn hint
  name=$(lookup "$1" "${2:-}")
  if [ -z "$name" ]; then
    warn "unknown command: $1"
    if valid_target "$1"; then note "'$1' is a target, not a command — try: ./$PROG start $1"; fi
    hint=$(suggest "$1"); [ -z "$hint" ] || note "did you mean: ./$PROG $hint"
    usage >&2; exit 2
  fi
  shift; case "$name" in *' '*) shift ;; esac  # a namespace consumes its second token
  if wants_help "$@"; then                     # one place makes `<cmd> --help` universal
    # shellcheck disable=SC2086  # deliberate split so a namespaced name arrives as two words
    cmd_help $name; return 0
  fi
  CURRENT_CMD="$name"; fn=$(fn_of "$name")
  "$fn" "$@"
}
if [ "${BASH_SOURCE[0]}" = "$0" ]; then main "$@"; fi
