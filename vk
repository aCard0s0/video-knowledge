    case "$1" in
      -f|--follow) follow=1 ;;
      -n|--tail)   [ $# -ge 2 ] || die "-n needs a line count" 2; tail="$2"; shift ;;
      -*) die "unknown option: $1 (try ./$PROG logs --help)" 2 ;;
      *)  valid_target "$1" || die "unknown target: $1. Groups: $TARGET_GROUPS. Services: $SERVICES" 2
          TARGETS+=("$1") ;;
