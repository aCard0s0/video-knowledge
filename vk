#!/usr/bin/env bash
# vk — the one script that runs this repo (video-knowledge: the vidingest backend, the
# operator console, postgres and two optional sidecars).
#
# HOW TO ADD A COMMAND (agents: read this before editing anything below)
#  1. Add ONE row to the COMMANDS registry:  name|alias|args|summary. A namespaced
#     command has a space in the name ("db migrate"); "#Label" starts a section. That
#     row is the ONLY place a command name may live — help, `<cmd> --help` and the
#     dispatcher are generated from it. Naming a command twice here is a bug, and
#     `./vk doctor` runs the drift lint that catches it.
#  2. Define cmd_<name>, spaces and dashes as underscores ("db migrate" ->
#     cmd_db_migrate). Optional long help: cmd_<fn>_help.
#  3. Bind arguments to named locals and validate ALL of them before the first side
#     effect, so `restart --typo` cannot tear the stack down and then fail. Reject
#     unknown flags; never accept-and-ignore an argument.
#  4. Side effects go through `run` (free --dry-run/--verbose), destructive ones
#     through `confirm` (free --yes, plus refusal on non-interactive stdin).
#  Invariants: no logic in the dispatcher; one arg-parsing idiom (while/case/shift);
#  targets are arguments to verbs (`./vk start vidingest`, never `./vk vidingest`);
#  human text only via say/note/step/warn/die — stdout carries values, stderr prose.
#  bash 3.2 (stock macOS): no associative arrays, no ${var,,}, no mapfile, and never a
#  bare "${a[@]}" that may be empty — write ${a[@]+"${a[@]}"}.
#
#  The model runtimes are NOT containers: transcription, embeddings and knowledge chat
#  all run on the host so inference reaches the GPU. `./vk doctor` probes the host one;
#  repoint any of them with `PUT /api/v1/connections/{name}` or the console's Settings.
#
#  ponytail: ~490 code lines, over the 400 at which the project-cli skill says to split the
#  cmd_ bodies into scripts/lib/<group>.sh. Left whole deliberately — that threshold exists
#  to stop a 2671-line monolith, and one file is still the cheaper thing to read at 18
#  commands. Split at ~25, keeping the registry, the dispatcher and the helpers here.
set -Eeuo pipefail
# ── identity & repo root (survives symlinks into ~/bin, and living in scripts/) ──
PROG="${0##*/}"; TAGLINE="build, run and inspect the video-knowledge stack"
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  _d=$(cd -P "$(dirname "$SELF")" && pwd); SELF=$(readlink "$SELF")
  case "$SELF" in /*) ;; *) SELF="$_d/$SELF" ;; esac
done
SCRIPT_DIR=$(cd -P "$(dirname "$SELF")" && pwd); ROOT="$SCRIPT_DIR"
while [ "$ROOT" != "/" ] && [ ! -e "$ROOT/.git" ]; do ROOT=$(dirname "$ROOT"); done
[ "$ROOT" != "/" ] || ROOT="$SCRIPT_DIR"
cd "$ROOT"
# ── config: every knob env-overridable, every name prefixed with the tool ──
PROJECT="${VK_PROJECT:-video-knowledge}"
WEBAPP_DIR="$ROOT/applications/webapp"
ENV_FILE="${VK_ENV_FILE:-$ROOT/.env}"
# Canonical host-port map, overridable from the environment. Sourced, not parsed: it is
# ours and it is plain KEY=VALUE.
# An if-block, not `[ -f x ] && . x`: the && form returns 1 when the file is absent,
# which trips the ERR trap on a checkout that has no ports.env.
if [ -f "$ROOT/compose/ports.env" ]; then
  set -a
  # shellcheck disable=SC1091
  . "$ROOT/compose/ports.env"
  set +a
fi
export VK_IMAGE_TAG="${VK_IMAGE_TAG:-latest}"
export VK_BIND_ADDR="${VK_BIND_ADDR:-127.0.0.1}"
# ── compose layering ────────────────────────────────────────────────────────────────
# Two of these are conditional, and both have to be decided before ANY compose call —
# `logs`, `down` and `status` need the same file set as the `up` that created the stack, or
# they simply cannot see the sidecar. So the layering is resolved once in main(), from the
# environment and from flags accepted anywhere on the line, rather than per command.
#
#   webapp-local.yml  the console's host port. On by default; off when --serve is given,
#                     because then the tailnet is the access path and a published port is a
#                     second door the ACL does not guard. --local forces it back.
#   tailscale.yml     the sidecar. Off unless --serve or VK_TAILSCALE_ENABLED=true.
TS_SERVE_MODE="${TS_SERVE_MODE:-}"
TAILSCALE_ON=""; LOCAL_PORT_ON=""
case "${VK_TAILSCALE_ENABLED:-}" in true|1|yes) TAILSCALE_ON=1 ;; esac
case "${LOCAL_PORT_ENABLED:-}" in true|1|yes) LOCAL_PORT_ON=1 ;; esac
COMPOSE_FILES=()
BASE_SERVICES="postgres paddleocr-server diarize-asr vidingest webapp vidingest-cli vidingest-mcp"
# Valid targets. Services feed compose directly; groups expand to a service list. Both
# are printed by `list` and by the help footer, and both feed the did-you-mean hint.
SERVICES="$BASE_SERVICES"
# Not GROUPS: that is a bash builtin holding the user's group ids, assignment to it is
# silently discarded, and `Groups: 20` in the help was the whole symptom.
TARGET_GROUPS="all infra sidecars backend"
GROUP_infra="postgres"                          # the model runtimes moved to the host
GROUP_sidecars="paddleocr-server diarize-asr"
GROUP_backend="vidingest webapp"                # the console is its own image
GROUP_all="$GROUP_infra $GROUP_backend"         # default footprint: no opt-in extras
DRY_RUN=""; ASSUME_YES=""; VERBOSE=""; CURRENT_CMD=""
TARGETS=(); OPT_BUILD=""; OPT_NOCACHE=""
ENVARG=(); if [ -f "$ENV_FILE" ]; then ENVARG=(--env-file "$ENV_FILE"); fi
# ── output: colour only on a TTY; values on stdout, prose on stderr ──
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  BOLD=$'\033[1m'; DIM=$'\033[2m'; RED=$'\033[31m'; YLW=$'\033[33m'; GRN=$'\033[32m'; RST=$'\033[0m'
else BOLD=''; DIM=''; RED=''; YLW=''; GRN=''; RST=''; fi
say()  { printf '%s\n' "$*"; }
note() { printf '%s%s%s\n' "$DIM" "$*" "$RST" >&2; }
step() { printf '%s→ %s%s\n' "$BOLD" "$*" "$RST" >&2; }
warn() { printf '%s%s: %s%s\n' "$YLW" "$PROG" "$*" "$RST" >&2; }
die()  { printf '%s%s: %s%s\n' "$RED" "$PROG" "$1" "$RST" >&2; exit "${2:-1}"; }
# exit codes: 0 ok · 1 runtime failure · 2 usage error · 3 missing dependency · 4 bad state
on_err() { local rc=$?; printf '%s%s: unexpected failure at line %s (exit %s)%s\n' "$RED" "$PROG" "${1:-?}" "$rc" "$RST" >&2; exit "$rc"; }
cleanup() { :; }
trap 'on_err $LINENO' ERR; trap cleanup EXIT
trap 'cleanup; exit 130' INT; trap 'cleanup; exit 143' TERM
# ── command registry: the single source of truth ──
# No field may contain a '|' — writing a flag as [-v|--volumes] truncates the row and
# corrupts help. Spell the short form in the command's own cmd_<name>_help instead.
COMMANDS=$(cat <<'REGISTRY'
#Lifecycle
start|up|[target...] [--build]|Start the stack detached and health-gated, or only the named targets
stop||[target...]|Halt containers, leaving them and their data in place
restart||[target...] [--build]|Stop then start the same targets, re-reading configuration
#Inspect
status|ps|[target...]|Report what is running and the ports actually bound
logs||[target...] [-f] [-n N]|Print the last 200 log lines; -f follows and blocks
list||[kind]|Print the target names the other verbs accept, one per line
#Develop
setup||[--force]|Prepare a fresh clone: install the console's npm dependencies
dev||[-- <ng args>]|Serve the console on :4200 with reload (foreground, blocks until Ctrl-C)
test||[suite...] [-- <args>]|Run the hermetic tests; suites: server console integration cli
fmt|format|[--check]|Format the console sources with prettier
build||[target...] [--no-cache]|Build the container images
#Teardown
down||[--volumes] [--yes]|Remove this project's containers and network; --volumes deletes its data
clean||[--all] [--yes]|Delete build artifacts this repo produced -- never containers or volumes
#Access
shell|sh|[--in <service>]|Open sh inside a running container
console|||Open the VidIngest Spring Shell console
#Meta
doctor|||Check this machine can operate the repo, and say what is broken
version|||Print the revision a bug should be filed against
help||[command]|Show this help, or the help for one command
REGISTRY
)
reg()       { printf '%s\n' "$COMMANDS"; }
reg_names() { reg | awk -F'|' 'NF>1 {print $1}'; }
reg_field() { reg | awk -F'|' -v n="$1" -v f="$2" '$1==n {print $f; exit}'; }
fn_of()     { printf 'cmd_%s' "$(printf '%s' "$1" | tr ' -' '__')"; }
lookup() {                             # lookup <tok> [tok2] -> canonical name, or empty
  local hit=""
  if [ -n "${2:-}" ]; then hit=$(reg_names | grep -Fx -- "$1 $2" || true); fi
  [ -n "$hit" ] || hit=$(reg_names | grep -Fx -- "$1" || true)
  [ -n "$hit" ] || hit=$(reg | awk -F'|' -v a="$1" 'NF>1 && $2==a {print $1; exit}')
  printf '%s' "$hit"
}
suggest() {
  reg_names | awk -v w="$1" '{ s=0
    if (index($0,w) || index(w,$0)) s=3; else if (substr($0,1,2)==substr(w,1,2)) s=2
    if (s>b) { b=s; best=$0 } } END { if (b>0) print best }'
}
valid_target() { case " $SERVICES $TARGET_GROUPS " in *" $1 "*) return 0 ;; esac; return 1; }
# A group expands to its services; a service is itself. Compose never sees a group name.
expand_target() {
  case "$1" in
    all)      printf '%s' "$GROUP_all" ;;
    infra)    printf '%s' "$GROUP_infra" ;;
    sidecars) printf '%s' "$GROUP_sidecars" ;;
    backend)  printf '%s' "$GROUP_backend" ;;
    *)        printf '%s' "$1" ;;
  esac
}
# The service list compose should act on: the expansion of every target given, or the
# default footprint when none were.
selected() {
  local t out=""
  if [ ${#TARGETS[@]} -eq 0 ]; then printf '%s' "$GROUP_all"; return 0; fi
  for t in ${TARGETS[@]+"${TARGETS[@]}"}; do out="$out $(expand_target "$t")"; done
  printf '%s' "${out# }"
}
wants_help() { local a; for a in "$@"; do case "$a" in -h|--help) return 0 ;; --) break ;; esac; done; return 1; }
# Read one value out of the env file WITHOUT sourcing it. Compose gets that file via
# --env-file and resolves ${...} from it, but this script never saw it — so a TS_AUTHKEY
# correctly placed in .env (which is where .env.example says to put it) read as missing and
# `start --serve` died with exit 4 on a working configuration. Validation has to look where
# the documented value actually lives.
#
# Not sourced, deliberately: the file is the operator's and may hold anything, and `source`
# would execute it. Last assignment wins, matching compose; a ` #` trailer is stripped
# because compose treats it as a comment, and surrounding quotes are removed.
env_value() {
  [ -f "$ENV_FILE" ] || return 0
  sed -n "s/^[[:space:]]*$1=//p" "$ENV_FILE" 2>/dev/null | tail -1 |
    sed -e 's/[[:space:]]\{1,\}#.*$//' -e 's/[[:space:]]*$//' \
        -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'\$/\1/"
}
# Rebuild the -f list and the target catalogue from the resolved layering. Called once,
# after the pre-scan, and before anything touches docker.
resolve_layering() {
  COMPOSE_FILES=(-f "$ROOT/compose.yml" -f "$ROOT/compose/infra/infra.yml"
    -f "$ROOT/compose/services.yml" -f "$ROOT/compose/cli.yml" -f "$ROOT/compose/mcp.yml")
  # --serve implies the sidecar, and the sidecar defaults the host port off.
  if [ -n "$TS_SERVE_MODE" ]; then TAILSCALE_ON=1; fi
  if [ -z "$TAILSCALE_ON" ] && [ -z "${LOCAL_PORT_ENABLED:-}" ]; then LOCAL_PORT_ON=1; fi
  if [ -n "$LOCAL_PORT_ON" ]; then COMPOSE_FILES+=(-f "$ROOT/compose/webapp-local.yml"); fi
  if [ -n "$TAILSCALE_ON" ]; then
    COMPOSE_FILES+=(-f "$ROOT/compose/tailscale.yml")
    SERVICES="$BASE_SERVICES tailscale"
    GROUP_all="$GROUP_infra $GROUP_backend tailscale"
    export TS_SERVE_MODE="${TS_SERVE_MODE:-https}"
    # Only read when the sidecar is actually in play, so `help` and `version` never touch
    # the key. A real shell variable wins over the file, which is what compose does too.
    TS_IMAGE_TAG="${TS_IMAGE_TAG:-$(env_value TS_IMAGE_TAG)}"
    TS_AUTHKEY="${TS_AUTHKEY:-$(env_value TS_AUTHKEY)}"
    TS_HOSTNAME="${TS_HOSTNAME:-$(env_value TS_HOSTNAME)}"
    export TS_IMAGE_TAG TS_AUTHKEY TS_HOSTNAME
  fi
}
# Strip the layering flags out of the argv before dispatch, so they work in front of the
# verb or after it — `./vk start --serve https` is what anyone types, and making every
# command's allow-list carry them would be six edits that drift. Stops at `--` so a
# passthrough (`./vk test server -- --local`) is left alone.
LAYERING_ARGS=()
extract_layering_flags() {
  LAYERING_ARGS=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --serve) [ $# -ge 2 ] || die "--serve needs a mode (https or funnel)" 2
               case "$2" in
                 https|funnel) TS_SERVE_MODE="$2" ;;
                 *) die "unknown serve mode: $2 (https, funnel)" 2 ;;
               esac
               shift ;;
      --serve=*) case "${1#--serve=}" in
                   https|funnel) TS_SERVE_MODE="${1#--serve=}" ;;
                   *) die "unknown serve mode: ${1#--serve=} (https, funnel)" 2 ;;
                 esac ;;
      --local)    LOCAL_PORT_ON=1; LOCAL_PORT_ENABLED=true ;;
      --no-local) LOCAL_PORT_ON="";  LOCAL_PORT_ENABLED=false ;;
      --) LAYERING_ARGS+=("$@"); return 0 ;;
      *)  LAYERING_ARGS+=("$1") ;;
    esac
    shift
  done
}

usage() {
  cat <<EOF
${BOLD}$PROG${RST} — $TAGLINE

Usage: ./$PROG [-n|--dry-run] [-y|--yes] [-v|--verbose] <command> [args...]
       ./$PROG <command> --help

Layering (accepted before or after the command):
  --serve https|funnel   add the tailscale sidecar; serve the console over TLS on the
                         tailnet. Drops the host port unless --local is also given.
  --local, --no-local    force the console's 127.0.0.1 port on or off

Commands:
EOF
  reg | awk -F'|' -v b="$BOLD" -v r="$RST" '
    /^#/ { printf "\n%s%s%s\n", b, substr($0,2), r; next }
    NF>1 { c=$1; if ($2!="") c=c ", " $2; printf "  %-12s %s\n", c, $4 }'
  printf '\nGroups:   %s\nServices: %s\n' "$TARGET_GROUPS" "$SERVICES"
  printf 'Config:   VK_IMAGE_TAG=%s  VK_BIND_ADDR=%s  (also VK_ENV_FILE, VK_PROJECT, NO_COLOR,\n' \
    "$VK_IMAGE_TAG" "$VK_BIND_ADDR"
  printf '          and every port in compose/ports.env)\n'
}
cmd_help() {
  if [ $# -eq 0 ]; then usage; return 0; fi
  local name fn
  name=$(lookup "$1" "${2:-}"); [ -n "$name" ] || die "no such command: $1" 2
  say "${BOLD}$PROG $name${RST} $(reg_field "$name" 3)"; say ""; say "  $(reg_field "$name" 4)"
  fn="$(fn_of "$name")_help"
  if declare -f "$fn" >/dev/null 2>&1; then say ""; "$fn"; fi
}
# ── preflight: never above the dispatcher — help must work with no docker installed ──
have() { command -v "$1" >/dev/null 2>&1; }
require_docker() {
  have docker || die "docker is not on PATH — install Docker Desktop, then retry" 3
  docker compose version >/dev/null 2>&1 || die "no 'docker compose' plugin — this needs Compose v2, not docker-compose" 3
  docker info >/dev/null 2>&1 || die "the Docker daemon is not running — start Docker Desktop" 3
}
require_maven() { [ -x "$ROOT/mvnw" ] || die "no ./mvnw at $ROOT — wrong repo, or the wrapper was deleted" 3; }
require_npm() {
  have npm || die "npm is not on PATH — install Node 22+, then retry" 3
  [ -d "$WEBAPP_DIR/node_modules" ] || die "the console's dependencies are not installed — run ./$PROG setup" 4
}
run() { if [ -n "$DRY_RUN$VERBOSE" ]; then note "+ $*"; fi; if [ -n "$DRY_RUN" ]; then return 0; fi; "$@"; }
confirm() {
  if [ -n "$ASSUME_YES" ]; then return 0; fi
  [ -t 0 ] || die "refusing to do this non-interactively — pass --yes if you mean it" 2
  printf '%s%s [y/N] %s' "$YLW" "$*" "$RST" >&2; local reply=""; read -r reply || true
  case "$reply" in y|Y|yes|YES) return 0 ;; *) die "aborted" 2 ;; esac
}
# One choke point. `dc` is the raw invocation, for read-only captures that must still
# produce a value under --dry-run; `compose` is the same thing behind run().
# The tailscale overlay uses ${TS_IMAGE_TAG:?} and ${TS_AUTHKEY:?} so a real `up` refuses to
# guess. That also breaks every read-only call — ps, logs, port, exec, the ones `status` is
# built from — so those get placeholders instead. `status` and `logs` have no business
# reading the auth key to list containers. cmd_start validates the real values first.
dc() {
  TS_IMAGE_TAG="${TS_IMAGE_TAG:-placeholder}" TS_AUTHKEY="${TS_AUTHKEY:-placeholder}" \
    docker compose -p "$PROJECT" "${COMPOSE_FILES[@]}" ${ENVARG[@]+"${ENVARG[@]}"} "$@"
}
# Everything a real mutation needs, checked before compose is allowed to guess.
require_tailscale_env() {
  [ -n "$TAILSCALE_ON" ] || return 0
  [ -n "${TS_IMAGE_TAG:-}" ] || die "TS_IMAGE_TAG is unset — pin the sidecar in $ENV_FILE (see .env.example)" 4
  [ -n "${TS_AUTHKEY:-}" ] || die "TS_AUTHKEY is unset — mint a reusable, tagged key and put it in $ENV_FILE (see compose/tailscale/ACL.md)" 4
  case "${TS_HOSTNAME:-video-knowledge}" in
    postgres|paddleocr-server|diarize-asr|vidingest|webapp|vidingest-cli|vidingest-mcp|tailscale)
      die "TS_HOSTNAME must not equal a compose service name — that name would resolve to two containers and Serve would 502 on about half of all requests" 4 ;;
  esac
}
# Observed, never configured: ask the daemon what its own name and state are. A status
# command that echoes TS_HOSTNAME back cannot tell you the node failed to authenticate.
tailnet_state() {
  [ -n "$TAILSCALE_ON" ] || return 0
  dc exec -T tailscale tailscale status --json 2>/dev/null | python3 -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(1)
me=d.get("Self") or {}
name=(me.get("DNSName") or "").rstrip(".")
print((d.get("BackendState") or "unknown")+" "+(name or "-"))' 2>/dev/null || true
}
compose() { run dc "$@"; }
# ── shared parsing: one idiom, plus a per-command allow-list so nothing is ignored ──
parse_targets() {                      # parse_targets "<allowed flags>" "$@"
  local allowed=" $1 "; shift; TARGETS=(); OPT_BUILD=""; OPT_NOCACHE=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -*) case "$allowed" in *" $1 "*) ;; *) die "unknown option: $1 (try ./$PROG $CURRENT_CMD --help)" 2 ;; esac
          case "$1" in --build) OPT_BUILD=1 ;; --no-build) OPT_BUILD="" ;; --no-cache) OPT_NOCACHE=1 ;; esac ;;
      *)  valid_target "$1" || die "unknown target: $1. Groups: $TARGET_GROUPS. Services: $SERVICES" 2
          TARGETS+=("$1") ;;
    esac
    shift
  done
}
no_args() { [ $# -eq 0 ] || die "$CURRENT_CMD takes no arguments (got: $1)" 2; }
# ── commands ──
do_build() {
  local f=(build) svc; svc=$(selected); [ -z "$OPT_NOCACHE" ] || f+=(--no-cache)
  step "building $svc  (tag=$VK_IMAGE_TAG)"
  # shellcheck disable=SC2086  # deliberate word split: a service list, never a path
  compose "${f[@]}" $svc
}
do_up() {
  local svc; svc=$(selected)
  step "starting $svc  (tag=$VK_IMAGE_TAG)"
  # --wait health-gates the return, so `start` cannot exit 0 before readiness. Never sleep.
  # shellcheck disable=SC2086
  compose up -d --wait $svc
  report_urls
}
# `docker compose port` does NOT print nothing when nothing is published — it prints
# `invalid IP:0` and exits 0. So an `[ -n "$out" ]` test reports a correctly-closed stack as
# exposed, which is precisely what `--serve` produces: it shipped as
# `console http://invalid IP:0/vidingest` on the first real tailnet start. Match a real
# host:port instead. A warning that cries wolf on every clean deploy is one nobody reads.
published() {
  local out; out=$(dc port "$1" "$2" 2>/dev/null || true)
  case "$out" in *:[1-9]*) printf '%s' "$out" ;; *) : ;; esac
}
# Measured, not configured: ask the engine what it actually bound. A published default
# printed as fact is the bug this exists to avoid.
report_urls() {
  local api web
  api=$(published vidingest "${VIDINGEST_PORT:-8051}")
  web=$(published webapp 8080)
  [ -z "$api" ] || say "api      http://${api}/vidingest"
  [ -z "$web" ] || say "console  http://${web}/vidingest"
  local ts state name
  ts=$(tailnet_state); state="${ts%% *}"; name="${ts##* }"
  if [ -n "$ts" ] && [ "$name" != "-" ]; then
    say "tailnet  https://${name}/vidingest  (${state})"
    [ "$state" = "Running" ] || warn "the node is '${state}', not Running — check TS_AUTHKEY and the ACL"
  elif [ -n "$TAILSCALE_ON" ]; then
    note "the sidecar has no node name yet — ./$PROG logs tailscale"
  fi
  if [ -z "$api$web$ts" ]; then note "no published ports yet — ./$PROG status"; fi
}
cmd_start() {
  parse_targets "--build --no-build" "$@"; require_docker; require_tailscale_env
  # Publishing to the internet must never be a quiet side effect of an env var somebody
  # edited last month, and this stack has no application authentication at all — the ACL is
  # the whole gate, which is exactly what funnel makes decoration.
  if [ "${TS_SERVE_MODE:-}" = "funnel" ]; then
    warn "FUNNEL: this publishes the console to the PUBLIC INTERNET."
    warn "This application has no authentication. Anyone with the URL could ingest videos,"
    warn "delete them, and repoint a connection so the server hands over its API key."
    confirm "publish to the public internet anyway?"
  fi
  if [ -n "$OPT_BUILD" ]; then do_build; fi; do_up
}
cmd_start_help() {
  say "  Converges: a target whose image, config or environment changed is recreated."
  say "  Returns only after compose reports every target healthy, so a following command"
  say "  can rely on the stack being up. Already-healthy is exit 0 with no churn."
  say "  --build rebuilds the selected targets first."
  say ""
  say "  --serve https    also start the tailscale sidecar and serve the console over TLS"
  say "                   on the tailnet. Drops the host port; --local keeps it too."
  say "  --serve funnel   the same, plus the public internet. Prompts, and should not be"
  say "                   used: nothing here authenticates. compose/tailscale/ACL.md."
}
cmd_build() { parse_targets "--no-cache" "$@"; require_docker; do_build; say "built (tag=$VK_IMAGE_TAG)"; }
cmd_build_help() {
  say "  Container images only. The jar and the console bundle are built inside their"
  say "  Dockerfiles; \`./$PROG test\` is what compiles them on the host."
}
cmd_stop() {
  parse_targets "" "$@"; require_docker; local svc; svc=$(selected)
  step "stopping $svc"
  # shellcheck disable=SC2086
  compose stop $svc
  say "stopped"
}
cmd_stop_help() { say "  Halts only. Removal is \`./$PROG down\`; build artifacts are \`./$PROG clean\`."; }
cmd_restart() {                        # parse once, up front: validate before side effects
  parse_targets "--build --no-build" "$@"; require_docker
  local svc; svc=$(selected)
  step "stopping $svc"
  # shellcheck disable=SC2086
  compose stop $svc
  if [ -n "$OPT_BUILD" ]; then do_build; fi; do_up
}
cmd_restart_help() {
  say "  Re-reads compose and the env file, unlike \`docker compose restart\`, so a change"
  say "  you just made takes effect. Flags mean exactly what they mean on start."
}
cmd_status() {
  parse_targets "" "$@"; require_docker
  # shellcheck disable=SC2086
  dc ps $(selected) || die "the Docker daemon answered but compose failed" 1
  report_urls
}
cmd_status_help() { say "  Exits 0 whenever it observed successfully, including when nothing is running."; }
cmd_list() {
  local kind="${1:-services}"
  [ $# -le 1 ] || die "list takes at most one kind (got: $2)" 2
  case "$kind" in
    services) printf '%s\n' $SERVICES ;;
    groups)   printf '%s\n' $TARGET_GROUPS ;;
    *)        die "unknown kind: $kind (services, groups)" 2 ;;
  esac
}
cmd_list_help() { say "  One bare name per line, so it composes with xargs. Kinds: services, groups."; }
cmd_logs() {
  local follow="" tail="200" f; TARGETS=()
