# Three teardown verbs, never aliases of each other: stop halts, down removes the local
# runtime, clean deletes build artifacts. `make clean`/`mvn clean` have trained everyone
# that clean is the harmless one, so clean must never be able to reach a container.
cmd_down() {
  local vols="" f
  while [ $# -gt 0 ]; do
    case "$1" in
      -v|--volumes) vols=1 ;;   # -v is volumes here, as in compose; verbose is --verbose only
      # Accepted here as well as globally because the registry row advertises it and
      # cmd_down_help tells you to type it. A flag a row promises and the parser rejects is
      # the defect the registry exists to prevent, and it was live until the selftest ran.
      -y|--yes) ASSUME_YES=1 ;;
      -*) die "unknown option: $1 (try ./$PROG down --help)" 2 ;;
      *)  die "down takes no targets (got: $1) — it removes the whole project" 2 ;;
    esac
    shift
  done
  require_docker
  if [ -n "$vols" ]; then
    confirm "remove every '$PROJECT' volume — the database, the sidecar models, the downloaded videos and the logs? this cannot be undone"
  fi
  # Order matters, and this is why `logout` lives in the teardown path rather than in a
  # runbook nobody reads: it has to happen while the container can still reach the
  # coordination server. Skip it and the machine entry survives holding the MagicDNS name,
  # so the next deploy authenticates fresh and comes up as video-knowledge-1 while every
  # URL, bookmark and ACL still points at the corpse.
  if [ -n "$TAILSCALE_ON" ] && [ -n "$(dc ps -q tailscale 2>/dev/null)" ]; then
    step "logging the node out of the tailnet"
    run dc exec -T tailscale tailscale logout || warn "logout failed — delete the machine at login.tailscale.com/admin/machines"
  fi
  f=(down --remove-orphans); [ -z "$vols" ] || f+=(--volumes)
  compose "${f[@]}"
  say "removed containers and the network${vols:+, and the data volumes}"
}
cmd_down_help() {
  say "  -v is short for --volumes, as in compose; verbose is --verbose only."
  say "  --volumes wipes the database, the cached sidecar models and every downloaded"
  say "  video. It prompts, and refuses a non-interactive shell unless you pass --yes."
  say "  The ollama_data volume from before the host-runtime move is not managed here;"
  say "  remove it by hand if it is still on the machine."
  say "  With --serve, the node is logged out of the tailnet first, while it can still"
  say "  reach the coordination server. Without that the machine entry keeps the MagicDNS"
  say "  name and the next deploy comes up as video-knowledge-1."
}
cmd_clean() {
  local all=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --all) all=1 ;;
      -y|--yes) ASSUME_YES=1 ;;
      -*) die "unknown option: $1 (try ./$PROG clean --help)" 2 ;;
      *)  die "clean takes no targets (got: $1)" 2 ;;
    esac
    shift
  done
  # Only regenerable files this repo produced. No containers, no volumes, no remote
  # resources, nothing git-tracked, never the .env. Keep this list explicit.
  require_maven
  # The bare form is the safe reflex and never prompts. --all is different: node_modules is
  # a network round-trip to rebuild, not a recompile, so it is the one branch here that has
  # to ask. Everything else clean touches is regenerable from the working tree alone.
  if [ -n "$all" ]; then
    confirm "also remove node_modules? ./$PROG setup has to run again before dev, test or fmt"
  fi
  step "removing build artifacts"
  run "$ROOT/mvnw" -q clean
  run rm -rf "$WEBAPP_DIR/dist" "$WEBAPP_DIR/.angular" "$ROOT/target"
  [ -z "$all" ] || run rm -rf "$WEBAPP_DIR/node_modules"
  say "clean${all:+ --all} done"
}
cmd_clean_help() {
  say "  Maven target/ trees, the console's dist/ and .angular/ cache."
  say "  --all also removes node_modules, so \`./$PROG setup\` has to run again. That is the"
  say "  one branch that prompts; pass --yes for a non-interactive caller. The bare form is"
  say "  the safe reflex and never asks."
  say "  Containers and volumes are \`./$PROG down\`; this never touches them."
}
cmd_setup() {
  local force=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1 ;;
      -*) die "unknown option: $1 (try ./$PROG setup --help)" 2 ;;
      *)  die "setup takes no arguments (got: $1)" 2 ;;
    esac
    shift
  done
  have npm || die "npm is not on PATH — install Node 22+, then retry" 3
  if [ -d "$WEBAPP_DIR/node_modules" ] && [ -z "$force" ]; then
    say "console dependencies already installed"
  else
    step "installing the console's dependencies (npm ci)"
    run sh -c "cd '$WEBAPP_DIR' && npm ci"
  fi
  # Never seeded, never overwritten: .env is gitignored, holds the HuggingFace token, and
  # every value in it has a working compose default. Absence is a valid state.
  [ -f "$ENV_FILE" ] || note "no $ENV_FILE — compose defaults apply; see compose/ports.env"
  say "ready — next: ./$PROG start"
}
cmd_setup_help() {
  say "  Idempotent: a second run reports what it verified rather than reinstalling."
  say "  Maven needs nothing — ./mvnw downloads its own toolchain on first use."
  say "  It never writes .env, which is gitignored and may hold a HuggingFace token."
}
cmd_dev() {
  local passthrough=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --) shift; passthrough=("$@"); break ;;
      *)  die "dev takes no arguments before -- (got: $1)" 2 ;;
    esac
  done
  require_npm
  # A port already in use is a precondition that BLOCKS the transition, which the vocabulary
  # spells exit 4. Without this, ng's own failure surfaces as a bare 127 from npm through the
  # ERR trap — which is what a stale `dev` from an earlier run actually looks like, and it
  # reads as a broken toolchain rather than an occupied port. Only checked when no
  # passthrough was given, since `-- --port 4300` legitimately moves it.
  if [ ${#passthrough[@]} -eq 0 ] && have lsof && lsof -nP -iTCP:4200 -sTCP:LISTEN >/dev/null 2>&1; then
    die "port 4200 is already in use — stop the other dev server, or ./$PROG dev -- --port 4300" 4
  fi
  step "ng serve on :4200 — proxies /vidingest to the server on :${VIDINGEST_PORT:-8051}"
  note "this blocks until Ctrl-C"
  run sh -c "cd '$WEBAPP_DIR' && npm start -- \"\$@\"" sh ${passthrough[@]+"${passthrough[@]}"}
}
cmd_dev_help() {
  say "  The console only. The server it proxies to must already be up (./$PROG start)."
  say "  Blocks until Ctrl-C — there is no \`dev stop\`."
}
run_suite_server()  { run "$ROOT/mvnw" -q test -Dtest='!*IntegrationTest' -Dsurefire.failIfNoSpecifiedTests=false "$@"; }
run_suite_console() { run sh -c "cd '$WEBAPP_DIR' && npm test -- --no-watch \"\$@\"" sh "$@"; }
run_suite_integration() { run "$ROOT/mvnw" -q test -Dtest='*IntegrationTest' -Dsurefire.failIfNoSpecifiedTests=false "$@"; }
# This file's own tests. Not hermetic — it cycles the postgres container and runs `clean` —
# so it is a named suite and never in the default set.
run_suite_cli() { run "$ROOT/scripts/vk-selftest.sh" "$@"; }
cmd_test() {
  local suites=() passthrough=() s
  while [ $# -gt 0 ]; do
    case "$1" in
      --) shift; passthrough=("$@"); break ;;
      -*) die "unknown option: $1 (try ./$PROG test --help)" 2 ;;
      server|console|integration|cli) suites+=("$1") ;;
      *)  die "unknown suite: $1 (server, console, integration, cli)" 2 ;;
    esac
    shift
  done
  if [ ${#suites[@]} -eq 0 ]; then
    suites=(server console)
    # Naming what was skipped is the contract: a green run that tested nothing is the
    # worst possible answer, and `integration` needs a Docker daemon for Testcontainers.
    note "hermetic suites only. Omitted: integration — run it with ./$PROG test integration"
  fi
  for s in ${suites[@]+"${suites[@]}"}; do
    case "$s" in
      server)      require_maven; step "server unit tests"; run_suite_server ${passthrough[@]+"${passthrough[@]}"} ;;
      console)     require_npm;   step "console tests";     run_suite_console ${passthrough[@]+"${passthrough[@]}"} ;;
      integration) require_maven; require_docker
                   step "Testcontainers integration tests (pgvector/pgvector:pg17)"
                   run_suite_integration ${passthrough[@]+"${passthrough[@]}"} ;;
      cli)         require_docker; step "./vk's own command surface (mutates: see the header)"
                   run_suite_cli ${passthrough[@]+"${passthrough[@]}"} ;;
    esac
  done
  say "tests passed: ${suites[*]}"
}
cmd_test_help() {
  say "  Bare \`test\` is hermetic: no daemon, no network, no running stack."
  say "    server       412 unit tests via ./mvnw, Testcontainers excluded"
  say "    console      the Angular specs via ng test --no-watch"
  say "    integration  needs a Docker daemon; boots pgvector/pgvector:pg17"
  say "    cli          this script's own 112 checks. MUTATES: cycles the postgres"
  say "                 container and runs clean. Destructive paths are aimed at an"
  say "                 isolated VK_PROJECT, never at your stack."
  say "  Everything after -- goes verbatim to the harness, e.g."
  say "    ./$PROG test server -- -Dtest=FusePhaseTest"
}
