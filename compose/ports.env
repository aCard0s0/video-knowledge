# Canonical port map (host ports) for VidIngest.
# Override any value by exporting an env var before running vk/Compose,
# e.g. `LLM_PORT=11500 ./vk start`. The `${VAR:-default}`
# form means an already-exported value wins; otherwise the default applies.

# Infra
POSTGRES_PORT="${POSTGRES_PORT:-3030}"
PADDLEOCR_PORT="${PADDLEOCR_PORT:-8002}"
DIARIZE_ASR_PORT="${DIARIZE_ASR_PORT:-9001}"

# VidIngest
VIDINGEST_PORT="${VIDINGEST_PORT:-8051}"
# The console container. The server also serves the console on VIDINGEST_PORT from the jar.
WEBAPP_PORT="${WEBAPP_PORT:-8052}"
VIDINGEST_MCP_PORT="${VIDINGEST_MCP_PORT:-8055}"

# The LLM runtime is not a container: it runs on the host (oMLX, LM Studio, ollama, ...) so that
# inference reaches the GPU, which a Docker VM cannot. host.docker.internal resolves to the host
# from inside a container; services.yml adds the matching extra_hosts entry so this works on Linux
# too. The URL must include the API prefix the server exposes, usually /v1.
#
# The host process must bind 0.0.0.0, not 127.0.0.1 — a container arrives on the bridge address,
# so a loopback-only listener refuses the connection.
VK_HOST_LLM_URL="${VK_HOST_LLM_URL:-http://host.docker.internal:8000/v1}"
