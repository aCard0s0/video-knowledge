# Canonical port map (host ports) for VidIngest.
# Override any value by exporting an env var before running Tradey/Compose,
# e.g. `OLLAMA_PORT=11500 ./scripts/tradey.sh start`. The `${VAR:-default}`
# form means an already-exported value wins; otherwise the default applies.

# Infra
POSTGRES_PORT="${POSTGRES_PORT:-3030}"
OLLAMA_PORT="${OLLAMA_PORT:-11434}"
WHISPER_PORT="${WHISPER_PORT:-9000}"
PADDLEOCR_PORT="${PADDLEOCR_PORT:-8002}"
DIARIZE_ASR_PORT="${DIARIZE_ASR_PORT:-9001}"

# VidIngest
VIDINGEST_PORT="${VIDINGEST_PORT:-8051}"
VIDINGEST_MCP_PORT="${VIDINGEST_MCP_PORT:-8055}"
